&ITERATION
TOL = 1d-08,                  !iteration tolerance
TMAX = 10,                !Maximum iteration step
/

&GSIS
ACCFLAG = 0,               !0-CIS, 1-GSIS
/

&VELMSH
NPOLE = 20,                      !# of discrete polar angle
NAZIM = 40,                      !# of discrete azimuthal angle
/

&DG
DEG = 3,                       ! degree of polynomial in DG discretization
/

&FLOW
Cv = 1.0d0,                    !specific heat
Vg = 1.0d0,                    !magnitude of group velocity
TAU_R = 0.001d0,                      !mean free time of resistive scattering
TAU_N = 0.01d0,                     !mean free time of normal scattering
TAU_THR = 1.0d0,                    !threhold value in GSIS correction
/

&FILENAME
FNAME_MSH = './A1_Nx11_Ny11.msh',      !file name for spatial mesh
/

&N_BC
NBC = 4,
/

&BC
BC_NAME = 'SWall', 'NWall', 'EWall', 'WWall',
BC_PHYID = 11, 12, 13, 14,
BC_TYP = 1, 1, 1, 1,
BC_TEMP = 0.0d0, 1.0d0, 0.0d0, 0.0d0,
BC_XOFF = 0.0d0, 0.0d0, 0.0d0, 0.0d0,
BC_YOFF = 0.0d0, 0.0d0, 0.0d0, 0.0d0,
/

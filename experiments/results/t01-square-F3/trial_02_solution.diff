+            budget = tmax - red.sweeps - 1
+            if budget < 1 or final <= tol:
+                break
+            dy, _, nit, _ = fgmres(op, r, precon, tol * bnorm / rnorm,
+                                   min(restart, budget), red.n,
+                                   on_iterate=on_iterate)
+            info["krylov"] += nit
+            precon = make_precon(info["lo"]) if info["lo"] is not None else identity
+            y = y + dy
+            ylast = red.step(y)
+            r = ylast - y
+            rnorm = float(np.linalg.norm(r))
+            final = rnorm / bnorm if bnorm > 0 else 0.0
+            info["scale"] = final
+            residuals.append(final)
+            masses.append(self.mom.mass)
+            info["restarts"] += 1
+        wall = time.perf_counter() - t0
+
+        return self._record(
+            red.sweeps, bool(final <= tol), residuals, masses, None, wall,
+            scheme="FGMRES",
+            extra={"krylov_iterations": info["krylov"],
+                   "krylov_restarts": info["restarts"] - 1,
+                   "preconditioner": f"P{info['kdeg']}" if info["kdeg"] else "none",
+                   "preconditioner_seconds": info["build"],
+                   "reduced_dim": red.n,
+                   "target_residual": tol})
+
     def _record(self, iterations, converged, residuals, masses, true_res, wall,
                 scheme, extra=None) -> RunRecord:
         """Assemble the run record from the solver's current state."""

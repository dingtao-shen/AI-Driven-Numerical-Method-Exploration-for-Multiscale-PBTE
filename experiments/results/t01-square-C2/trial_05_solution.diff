     # -- the outer loop -----------------------------------------------------
     def run(self, callback=None, progress_every: int = 0) -> RunRecord:
+        """Solve the case.
+
+        The loop the Fortran wrote -- sweep, moments, stop on
+        ``Calculate_Residual_T < tol`` -- is Richardson iteration on the
+        moment fixed point, and it converges at a rate that degenerates as
+        ``tau_C/L -> 0``.  :mod:`pybte.accel` solves the *same* fixed point
+        with GMRES preconditioned by its diffusion limit, which costs the same
+        one sweep per iteration and converges in tens of them at every
+        stiffness.  ``run_source_iteration`` keeps the original loop.
+        """
+        c = self.case
+        if int(self.order.cycles_broken.sum()) or self.bcdata.has_periodic:
+            # both make a sweep read VDF values the same sweep has not yet
+            # overwritten -- a broken cycle by construction, a periodic pair
+            # because the partner element is not ordered against this one --
+            # so the iteration is no longer a map on the moments alone
+            return self.run_source_iteration(callback, progress_every)
+
+        from .accel import MomentSystem
+
+        tol, tmax = c.iteration.tol, c.iteration.tmax
+        t0 = time.perf_counter()
+        ms = MomentSystem(self)
+        maxiter = max(1, min(int(tmax) - 2, 5000))
+
+        cb = None
+        if callback is not None or progress_every:
+            def cb(step, res):
+                if progress_every and step % progress_every == 0:
+                    print(f"  step {step:8d}  residual {res:.6e}", flush=True)
+                if callback is not None:
+                    callback(step, res, self)
+
+        u0 = ms.state_from_vdf() if self.restart_info["enabled"] else None
+        u, residuals, converged = ms.solve(maxiter=maxiter,
+                                           restart=min(maxiter, 400),
+                                           x0=u0, callback=cb)
+        self._accel_sweeps = ms.sweeps
+
+        # ``solve`` leaves VDF, the moments and the wall emission all belonging
+        # to the same iterate; that pair is what the verifier reads.  Report
+        # the Fortran's own stopping quantity across that last sweep.
+        t_prev = (u[:ms.nmom].reshape(self.ndof, self.n_tris)
+                  * self.integrals.int_tri).sum(axis=0) / c.flow.cv
+        res = residual_iterate(self.mom.temp, t_prev)
+        residuals.append(res)
+        self.t_old[:] = self.mom.temp
+        converged = bool(converged and res < tol and ms.sweeps <= tmax)
+
+        step = ms.sweeps
+        if not converged and step < tmax:
+            # never do worse than the loop we replaced: spend whatever budget
+            # is left on plain source iteration, warm-started from here
+            while step < tmax:
+                step += 1
+                self.step()
+                res = residual_iterate(self.mom.temp, self.t_old)
+                self.t_old[:] = self.mom.temp
+                residuals.append(res)
+                if res < tol:
+                    converged = True
+                    break
+            ms.sweeps = step
+
+        wall = time.perf_counter() - t0
+        masses = [float(self.mom.temp.sum())]
+        true_res = None
+        if c.iteration.true_residual:
+            true_res = [self.ctx.true_residual(self.mom, self.vdf)]
+        return self._record(ms.sweeps, converged, residuals, masses,
+                            true_res, wall, scheme="DSA-GMRES",
+                            extra={"krylov_sweeps": ms.sweeps,
+                                   "moment_unknowns": ms.size})

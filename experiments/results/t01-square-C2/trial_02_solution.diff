+    used = 0
+    while used < maxit:
+        if np.any(x):
+            r = precond(b - matvec(x))
+            used += 1
+        else:
+            r = precond(b)
+        beta = float(np.linalg.norm(r))
+        if beta <= rtol * ref:
+            return x, residuals, True
+        cap = min(restart, maxit - used)
+        if cap <= 0:
+            break
+        V = np.empty((min(cap, 32) + 1, n))
+        H = np.zeros((min(cap, 32) + 1, min(cap, 32)))
+        cs = np.zeros(cap)
+        sn = np.zeros(cap)
+        g = np.zeros(cap + 1)
+        V[0] = r / beta
+        g[0] = beta
+        k = 0
+        converged = False
+        for j in range(cap):
+            if j + 1 >= V.shape[0]:                    # grow, geometrically
+                grow = min(cap, 2 * j) + 1
+                Vn = np.empty((grow + 1, n)); Vn[:V.shape[0]] = V; V = Vn
+                Hn = np.zeros((grow + 1, grow)); Hn[:H.shape[0], :H.shape[1]] = H
+                H = Hn
+            w = precond(matvec(V[j]))
+            used += 1
+            for i in range(j + 1):
+                H[i, j] = V[i] @ w
+                w -= H[i, j] * V[i]
+            # one pass of re-orthogonalisation: the operator is far from normal
+            for i in range(j + 1):
+                corr = V[i] @ w
+                H[i, j] += corr
+                w -= corr * V[i]
+            H[j + 1, j] = float(np.linalg.norm(w))
+            if H[j + 1, j] > 0.0:
+                V[j + 1] = w / H[j + 1, j]
+            for i in range(j):
+                t = cs[i] * H[i, j] + sn[i] * H[i + 1, j]
+                H[i + 1, j] = -sn[i] * H[i, j] + cs[i] * H[i + 1, j]
+                H[i, j] = t
+            d = np.hypot(H[j, j], H[j + 1, j])
+            if d == 0.0:
+                cs[j], sn[j] = 1.0, 0.0
+            else:
+                cs[j], sn[j] = H[j, j] / d, H[j + 1, j] / d
+            H[j, j] = cs[j] * H[j, j] + sn[j] * H[j + 1, j]
+            H[j + 1, j] = 0.0
+            g[j + 1] = -sn[j] * g[j]
+            g[j] = cs[j] * g[j]
+            k = j + 1
+            residuals.append(abs(g[j + 1]) / ref)
+            if residuals[-1] <= rtol:
+                converged = True
+                break
+        if k:
+            yk = np.linalg.solve(np.triu(H[:k, :k]), g[:k])
+            x = x + V[:k].T @ yk
+        if converged:
+            return x, residuals, True
+        if k == 0:
+            break
+    return x, residuals, False

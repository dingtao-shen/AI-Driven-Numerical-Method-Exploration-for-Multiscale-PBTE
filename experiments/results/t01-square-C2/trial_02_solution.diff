+
+    def pack_current(self):
+        """The state that the solver's current moments/VDF already represent."""
+        s = self.s
+        y = np.empty(self.n)
+        y[0:self.n1] = s.mom.ts.ravel()
+        y[self.n1:2 * self.n1] = s.mom.qxs.ravel()
+        y[2 * self.n1:self.nmom] = s.mom.qys.ravel()

+    Returns ``(x, residuals, converged)``; ``residuals`` are relative
+    preconditioned residual norms, one per matvec performed.
+    """
+    n = b.size
+    ref = float(np.linalg.norm(precond(b)))
+    residuals = []
+    x = np.array(x0, dtype=float, copy=True)
+    if ref == 0.0:
+        return x, residuals, True

+    #: build the T-q coupled system only when N-scattering actually dominates
+    COUPLED_RATIO = 3.0
+    #: MIP penalty floor, in units of the mean free path.  Wang & Ragusa put
+    #: it at 1/4; on this discretisation 1/2 is the flat optimum and 1/8 or
+    #: below loses the thick-cell consistency the floor exists for.
+    PEN_FLOOR = 0.5
+    #: Marshak boundary coefficient, again per mean free path
+    ROBIN = 0.5
+    #: (Vg tau_C)^2 * DIFF_T * (-lap) is the energy operator ...
+    DIFF_T = 1.0 / 3.0
+    #: ... and DIFF_Q the momentum (viscous) one
+    DIFF_Q = 1.0 / 5.0
+
+    def __init__(self, solver, elem=None):
+        c = solver.case
+        m = solver.mesh
+        bd = solver.bcdata
+        self.nd = nd = solver.ndof
+        self.nt = nt = solver.n_tris
+        self.n1 = nd * nt
+        self.mass = solver.integrals.int_tri_tri
+
+        vg = c.flow.vg
+        cv = c.flow.cv
+        tau_c = c.tau_c
+        lam = vg * tau_c
+        delta = tau_c / c.flow.tau_r          # tau_C/tau_R, the resistive share
+        beta = tau_c / c.flow.tau_n           # tau_C/tau_N, the normal share
+        self.delta = delta
+
+        el = _ElementOperators(m, solver.basis, solver.integrals, c.dg.deg) \
+            if elem is None else elem
+
+        therm = np.zeros(m.n_faces)
+        allb = np.zeros(m.n_faces)
+        for f in range(m.n_faces):
+            b = int(m.face_bc[f])
+            if b >= 0:
+                allb[f] = self.ROBIN * lam
+                if bd.bc_type[b] == BC_THERMALISING:
+                    therm[f] = self.ROBIN * lam
+
+        # energy: (Vg tau_C)^2/3 * (-lap), Marshak wall, MIP penalty floor
+        kt = el.laplacian(lam * lam * self.DIFF_T, self.PEN_FLOOR * lam, therm)
+        # momentum: delta + beta (Vg tau_C)^2/5 * (-lap)
+        lq = el.laplacian(lam * lam * self.DIFF_Q * beta,
+                          self.PEN_FLOOR * lam * beta, allb * beta,
+                          mass_coef=delta, mass=self.mass)
+
+        self.coupled = beta > 0.0 and c.flow.tau_r > self.COUPLED_RATIO * c.flow.tau_n
+        if self.coupled:
+            gx, gy = el.gradients()
+            c1 = beta * tau_c / cv
+            c2 = cv * vg * vg * tau_c / 3.0
+            zero = sp.csr_matrix((self.n1, self.n1))
+            A = sp.bmat([[kt, c1 * gx, c1 * gy],
+                         [c2 * gx, lq, zero],
+                         [c2 * gy, zero, lq]], format="csc")
+            self.lu = _factorise(A)
+            self.lu_t = self.lu_q = None
+        else:
+            self.lu_t = _factorise(kt.tocsc())
+            if self._viscous_negligible(beta, lam, delta, m):
+                # lq is delta*M, which is block diagonal: invert it directly
+                self.lu_q = None
+                self.minv = np.linalg.inv(np.transpose(self.mass, (2, 0, 1))) / delta
+            else:
+                self.lu_q = _factorise(lq.tocsc())
+            self.lu = None
+
+    @staticmethod
+    def _viscous_negligible(beta, lam, delta, mesh):
+        """Is ``beta (Vg tau_C)^2/5 * (-lap)`` lost in ``delta`` on this mesh?
+
+        When it is -- the whole ``tau_N -> inf`` family -- the momentum block
+        is just ``delta * M``, which is block diagonal and needs no factors.
+        """
+        h = float(mesh.hmin)
+        return beta * lam * lam / (5.0 * h * h) < 1.0e-10 * delta if delta else False

+# ---------------------------------------------------------------------------
+# GMRES
+# ---------------------------------------------------------------------------
+def gmres_solve(matvec, precond, b, x0, rtol, maxit, restart=200):
+    """Left-preconditioned GMRES, restarted every ``restart`` matvecs.
+
+    Left preconditioning is deliberate: ``M`` approximates ``(I - G)^{-1}``,
+    so ``||M r||`` estimates the *error* rather than the residual, and
+    stopping on it is stopping on the quantity the benchmark grades.
+
+    The Krylov basis is grown geometrically instead of being sized for
+    ``maxit``, which on the shipped cases is ``TMAX = 30000``: nothing here
+    ever needs more than a few tens of vectors, and reserving room for thirty
+    thousand of them would cost more memory than the whole solver.

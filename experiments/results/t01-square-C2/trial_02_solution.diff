+        # it just enough to factorise -- GMRES absorbs the difference
+        n = A.shape[0]
+        scale = abs(A.diagonal()).max() or 1.0
+        return spla.splu((A + 1.0e-8 * scale * sp.eye(n, format="csc")).tocsc())

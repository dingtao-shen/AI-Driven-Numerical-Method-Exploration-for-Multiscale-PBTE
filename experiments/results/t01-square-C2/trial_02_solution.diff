+def _factorise(A):
+    """Sparse LU with the ordering that suits these operators.
+
+    They are structurally symmetric and nearly diagonally dominant, so the
+    ``A + A^T`` minimum-degree ordering with static pivoting factorises them
+    an order of magnitude faster than the ``COLAMD`` default and produces a
+    third of the fill.  Partial pivoting is restored if that fails: this is
+    a preconditioner, but a preconditioner that raises is no use.
+    """

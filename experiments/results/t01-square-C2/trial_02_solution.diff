+    # -- transfers between (ndof, n_tris) fields and element-major vectors --
+    def _weak(self, f):
+        return np.einsum("mli,li->im", self.mass, f).ravel()
+
+    @staticmethod
+    def _to_field(v, nd, nt):
+        return v.reshape(nt, nd).T
+
+    def apply(self, r, out=None):
+        nd, nt, n1 = self.nd, self.nt, self.n1
+        a = r[:3 * n1].reshape(3, nd, nt)

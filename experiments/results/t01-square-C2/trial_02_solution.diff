diff -ruN -x __pycache__ -x '*.pyc' -x .pytest_cache -x out environment/pybte/accel.py solution/pybte/accel.py
--- environment/pybte/accel.py	1970-01-01 08:00:00.000000000 +0800
+++ solution/pybte/accel.py	2026-09-10 06:26:03.106269419 +0800
@@ -0,0 +1,574 @@
+"""Krylov acceleration of the source iteration.
+
+The outer iteration of :mod:`pybte.driver` is a fixed point in the
+*macroscopic* unknowns alone::
+
+    y = (T_s, qx_s, qy_s [, wall emission])        y = G y + g
+
+``G`` is affine: the sweep is an exact transport solve, so one call to
+``ctx.sweep`` followed by ``compute_moments`` evaluates ``G y + g`` at the
+cost of a single sweep, and ``g = Phi(0)``.  Source iteration is Richardson
+on that system, and its spectral radius approaches one whenever the medium
+is optically thick -- which is exactly what makes ``tau_R = 1e-3`` and the
+hydrodynamic pair unreachable in 30 000 sweeps.
+
+Two things are done about it.
+
+**Krylov.**  ``(I - G) y = g`` is handed to GMRES instead of to Richardson.
+Every matvec is still one sweep, so nothing about the transport solve
+changes; only the way the iterates are combined does.
+
+**Diffusion synthetic acceleration.**  Krylov alone is not enough (the
+spectrum of ``I - G`` collapses towards zero like ``(tau_C k)^2``), so GMRES
+is preconditioned with the low-order system that the transport operator
+tends to in the thick limit.  Fourier analysis of one sweep gives, for a
+plane wave of wavenumber ``k`` and ``a = k Vg tau_C``,
+
+    (I - G)_TT  = 1 - arctan(a)/a               ~ a^2/3
+    (I - G)_Tq  = beta tau_C / Cv * div
+    (I - G)_qT  = Cv Vg^2 tau_C / 3  * grad
+    (I - G)_qq  = delta + beta a^2/5 (transverse), + 3 beta a^2/5 (longitudinal)
+
+with ``delta = tau_C/tau_R`` and ``beta = tau_C/tau_N``.  Eliminating ``q``
+gives the familiar Fourier diffusion operator with ``kappa ~ Vg^2 tau_R/3``;
+keeping it gives the phonon-hydrodynamic (Guyer-Krumhansl) system that the
+``tau_R = 10, tau_N = 0.01`` pair needs, where the slowly converging mode is
+transverse momentum, not energy.
+
+Those operators are discretised on the *same* nodal DG space as the
+transport solve, with a modified interior penalty (MIP) Laplacian.  A
+continuous-FEM diffusion preconditioner is inconsistent for DG transport
+once the cells are many mean free paths thick -- at ``tau_R = 1e-3`` a cell
+is 100 mfp across -- and degrades to the point of uselessness there; the MIP
+form does not.
+
+The preconditioner only has to be *good*, never exact: it is applied inside
+GMRES, which converges to the same fixed point the shipped solver has.
+
+Diffusely reflecting walls need one more trick.  Their emission is a lagged
+state variable, and the lag couples to the interior through a block of rank
+``n_wall_faces * ndof`` which GMRES otherwise has to resolve one dimension at
+a time.  Writing the wall unknown as the *departure* from the local
+blackbody value ``-Cv/(4 pi) * oint phi_m T`` removes almost all of that
+coupling, and with it a factor of five in iteration count on the ``F2``
+family.
+"""
+from __future__ import annotations
+
+import numpy as np
+import scipy.sparse as sp
+import scipy.sparse.linalg as spla
+
+from .constants import BC_NONTHERMALISING, BC_THERMALISING, PI
+from .moments import compute_moments
+
+__all__ = ["MomentSystem", "DSAPreconditioner", "gmres_solve", "KRYLOV_RTOL"]
+
+#: Relative preconditioned-residual tolerance for the outer GMRES.  Left
+#: preconditioning makes that an estimate of the *error*, and the benchmark
+#: asks for 1e-5 on the temperature, so this leaves five orders of margin.
+KRYLOV_RTOL = 1.0e-10
+
+
+# ---------------------------------------------------------------------------
+# geometry-only pieces of the interior-penalty operators
+# ---------------------------------------------------------------------------
+def _ref_derivative_at_nodes(basis):
+    """``(D_xi, D_eta)`` with ``D[m, n] = d phi_m / d xi`` at nodal point n."""
+    C = basis.nodfun_tri
+    mono = basis.mono
+    xi, eta = basis.node_tri[:, 0], basis.node_tri[:, 1]
+    nd = C.shape[0]
+    dxi = np.zeros((nd, nd))
+    deta = np.zeros((nd, nd))
+    for k, (a, b) in enumerate(mono):
+        if a > 0:
+            dxi += np.outer(C[:, k] * a, xi ** (a - 1) * eta ** b)
+        if b > 0:
+            deta += np.outer(C[:, k] * b, xi ** a * eta ** (b - 1))
+    return dxi, deta
+
+
+class _ElementOperators:
+    """Per-element gradients, stiffness and the face bookkeeping the
+    interior-penalty assembly needs.  Built once, reused for every operator."""
+
+    def __init__(self, mesh, basis, integrals, deg):
+        self.mesh = mesh
+        self.nd = nd = basis.ndof_tri
+        self.nt = nt = mesh.n_tris
+        self.deg = deg
+
+        dxi, deta = _ref_derivative_at_nodes(basis)
+        x = mesh.nodes[mesh.tri_nodes, 0]
+        y = mesh.nodes[mesh.tri_nodes, 1]
+        x1, x2, x3 = x[:, 0], x[:, 1], x[:, 2]
+        y1, y2, y3 = y[:, 0], y[:, 1], y[:, 2]
+        A = (x2 - x1) * (y3 - y1) - (x3 - x1) * (y2 - y1)
+        E = (x3 - x1) * (y2 - y1) - (x2 - x1) * (y3 - y1)
+        # d phi_m / dx and /dy, sampled at the nodal points, per element
+        self.dx = ((y3 - y1) / A)[:, None, None] * dxi + ((y2 - y1) / E)[:, None, None] * deta
+        self.dy = ((x1 - x3) / A)[:, None, None] * dxi + ((x1 - x2) / E)[:, None, None] * deta
+
+        gx = integrals.int_tri_tri_x                 # (i, m, l) = int dphi_m/dx phi_l
+        gy = integrals.int_tri_tri_y
+        kel = (np.einsum("iln,imn->iml", self.dx, gx)
+               + np.einsum("iln,imn->iml", self.dy, gy))
+        self.kel = 0.5 * (kel + np.transpose(kel, (0, 2, 1)))
+        self.gx, self.gy = gx, gy
+        self.fcm = integrals.int_tri_fc              # (i, il, m, l), same element
+        self.ttfc = integrals.int_tri_tri_fc         # (i, il, m, l), neighbour
+
+        edge = np.stack([np.linalg.norm(mesh.nodes[mesh.tri_nodes[:, (j + 1) % 3]]
+                                        - mesh.nodes[mesh.tri_nodes[:, j]], axis=1)
+                         for j in range(3)], axis=1)
+        self.hperp = 2.0 * mesh.tri_area[:, None] / edge
+        self.pen_c = deg * (deg + 1) / 2.0
+
+        interior = np.flatnonzero(mesh.face_bc < 0)
+        self.ip = mesh.face_tri[interior, 0].astype(np.int64)
+        self.im = mesh.face_tri[interior, 1].astype(np.int64)
+        self.lp = mesh.face_lfc[interior, 0].astype(np.int64)
+        self.lm = mesh.face_lfc[interior, 1].astype(np.int64)
+        self.fnx = mesh.tri_normal[self.ip, self.lp, 0]
+        self.fny = mesh.tri_normal[self.ip, self.lp, 1]
+        self.n_int = interior.size
+
+        bdry = np.flatnonzero(mesh.face_bc >= 0)
+        self.bfaces = bdry
+        bt = np.where(mesh.face_tri[bdry, 0] >= 0, 0, 1)
+        self.bi = mesh.face_tri[bdry, bt].astype(np.int64)
+        self.bl = mesh.face_lfc[bdry, bt].astype(np.int64)
+        self.bnx = mesh.tri_normal[self.bi, self.bl, 0]
+        self.bny = mesh.tri_normal[self.bi, self.bl, 1]
+
+        # sparsity pattern is the same for every operator assembled here
+        idx = np.arange(nd)
+        self._rr = np.repeat(idx, nd)
+        self._cc = np.tile(idx, nd)
+
+    # -- helpers -----------------------------------------------------------
+    def _pattern(self, bi, bj):
+        return (bi[:, None] * self.nd + self._rr[None, :],
+                bj[:, None] * self.nd + self._cc[None, :])
+
+    def _coo(self, pieces):
+        rows = np.concatenate([p[0].ravel() for p in pieces])
+        cols = np.concatenate([p[1].ravel() for p in pieces])
+        vals = np.concatenate([p[2].ravel() for p in pieces])
+        n = self.nt * self.nd
+        return sp.coo_matrix((vals, (rows, cols)), shape=(n, n))
+
+    # -- the operators -----------------------------------------------------
+    def laplacian(self, dcoef, pen_floor, bdry_coef, mass_coef=0.0, mass=None):
+        """MIP interior-penalty ``-dcoef * lap`` plus optional mass and a
+        Robin (Marshak) boundary term ``bdry_coef[f] * oint u v``."""
+        nt = self.nt
+        allt = np.arange(nt)
+        blk = dcoef * self.kel
+        if mass_coef:
+            blk = blk + mass_coef * np.transpose(mass, (2, 0, 1))
+        pieces = [self._pattern(allt, allt) + (blk,)]
+
+        if self.n_int:
+            ip, im, lp, lm = self.ip, self.im, self.lp, self.lm
+            nx, ny = self.fnx[:, None, None], self.fny[:, None, None]
+            dnp = nx * self.dx[ip] + ny * self.dy[ip]
+            dnm = nx * self.dx[im] + ny * self.dy[im]
+            fpp = self.fcm[ip, lp]
+            fmm = self.fcm[im, lm]
+            fpm = self.ttfc[ip, lp]
+            fmp = self.ttfc[im, lm]
+            sig = np.maximum(pen_floor,
+                             self.pen_c * dcoef * (1.0 / self.hperp[ip, lp]
+                                                   + 1.0 / self.hperp[im, lm]))
+            sig = sig[:, None, None]
+            t_pp = -0.5 * dcoef * np.einsum("fmn,fln->fml", fpp, dnp)
+            t_pm = -0.5 * dcoef * np.einsum("fmn,fln->fml", fpm, dnm)
+            t_mp = +0.5 * dcoef * np.einsum("fmn,fln->fml", fmp, dnp)
+            t_mm = +0.5 * dcoef * np.einsum("fmn,fln->fml", fmm, dnm)
+            tr = lambda a: np.transpose(a, (0, 2, 1))
+            pieces += [
+                self._pattern(ip, ip) + (t_pp + tr(t_pp) + sig * fpp,),
+                self._pattern(im, im) + (t_mm + tr(t_mm) + sig * fmm,),
+                self._pattern(ip, im) + (t_pm + tr(t_mp) - sig * fpm,),
+                self._pattern(im, ip) + (t_mp + tr(t_pm) - sig * fmp,),
+            ]
+        cb = np.asarray(bdry_coef)[self.bfaces]
+        keep = cb != 0.0
+        if np.any(keep):
+            bi = self.bi[keep]
+            pieces.append(self._pattern(bi, bi)
+                          + (cb[keep][:, None, None] * self.fcm[bi, self.bl[keep]],))
+        return self._coo(pieces).tocsr()
+
+    def gradients(self):
+        """Weak DG gradient with central fluxes: ``(Gx u)_m = int phi_m du/dx``.
+
+        The same pair also assembles the divergence, ``Gx qx + Gy qy``.
+        """
+        nt = self.nt
+        allt = np.arange(nt)
+        px = [self._pattern(allt, allt) + (-self.gx,)]
+        py = [self._pattern(allt, allt) + (-self.gy,)]
+        if self.n_int:
+            ip, im, lp, lm = self.ip, self.im, self.lp, self.lm
+            nx, ny = self.fnx[:, None, None], self.fny[:, None, None]
+            fpp = self.fcm[ip, lp]
+            fmm = self.fcm[im, lm]
+            fpm = self.ttfc[ip, lp]
+            fmp = self.ttfc[im, lm]
+            px += [self._pattern(ip, ip) + (0.5 * nx * fpp,),
+                   self._pattern(ip, im) + (0.5 * nx * fpm,),
+                   self._pattern(im, im) + (-0.5 * nx * fmm,),
+                   self._pattern(im, ip) + (-0.5 * nx * fmp,)]
+            py += [self._pattern(ip, ip) + (0.5 * ny * fpp,),
+                   self._pattern(ip, im) + (0.5 * ny * fpm,),
+                   self._pattern(im, im) + (-0.5 * ny * fmm,),
+                   self._pattern(im, ip) + (-0.5 * ny * fmp,)]
+        fb = self.fcm[self.bi, self.bl]
+        px.append(self._pattern(self.bi, self.bi) + (self.bnx[:, None, None] * fb,))
+        py.append(self._pattern(self.bi, self.bi) + (self.bny[:, None, None] * fb,))
+        return self._coo(px).tocsr(), self._coo(py).tocsr()
+
+
+# ---------------------------------------------------------------------------
+# the moment fixed point
+# ---------------------------------------------------------------------------
+class MomentSystem:
+    """``Phi(y) = G y + g`` -- one sweep, packed into the moment unknowns.
+
+    The state is ``(T_s, qx_s, qy_s)`` and, when a diffusely reflecting wall
+    is present, the departure of the wall emission from the local blackbody
+    value.  Everything the sweep reads is in there, so ``Phi`` is affine and
+    its fixed point is the fixed point of :meth:`pybte.driver.Solver.step`.
+    """
+
+    def __init__(self, solver):
+        self.s = solver
+        c = solver.case
+        m = solver.mesh
+        bd = solver.bcdata
+        self.nd = solver.ndof
+        self.nt = solver.n_tris
+        self.n1 = self.nd * self.nt
+        self.nmom = 3 * self.n1
+        self.cv = c.flow.cv
+
+        wall = np.array([bd.bc_type[b] == BC_NONTHERMALISING if b >= 0 else False
+                         for b in m.face_bc])
+        self.wfaces = np.flatnonzero(wall)
+        self.nw = self.wfaces.size
+        self.n = self.nmom + self.nw * self.nd
+        if self.nw:
+            side = np.where(m.face_tri[self.wfaces, 0] >= 0, 0, 1)
+            wtri = m.face_tri[self.wfaces, side].astype(np.int64)
+            wlfc = m.face_lfc[self.wfaces, side].astype(np.int64)
+            self.wtri = wtri
+            # oint phi_m phi_l on each reflecting face, times -Cv/4pi
+            self.wpsi = -(self.cv / (4.0 * PI)) * solver.integrals.int_tri_fc[wtri, wlfc]
+        self.sweeps = 0
+
+    # -- the blackbody part of the wall emission ---------------------------
+    def _psi(self, ts):
+        return np.einsum("wml,lw->wm", self.wpsi, ts[:, self.wtri])
+
+    def unpack(self, y):
+        return y[:self.nmom].reshape(3, self.nd, self.nt)
+
+    def apply(self, y, out=None):
+        """One sweep from state ``y``; returns ``Phi(y)``."""
+        s = self.s
+        bd = s.bcdata
+        ts, qxs, qys = self.unpack(y)
+        if self.nw:
+            e = y[self.nmom:].reshape(self.nw, self.nd)
+            bd.flux_wall[:] = 0.0
+            bd.flux_wall[self.wfaces] = self._psi(ts) + e
+        s.mom.ts[:] = ts
+        s.mom.qxs[:] = qxs
+        s.mom.qys[:] = qys
+        s.ctx.sweep(s.mom, s.vdf)
+        self.sweeps += 1
+        if self.nw:
+            bd.update_wall_flux(s.vdf, s.ctx.cxv, s.ctx.cyv, s.ctx.domega,
+                                s.integrals.int_tri_fc, s.mesh)
+        compute_moments(s.vdf, s.ctx.cxv, s.ctx.cyv, s.ctx.domega,
+                        s.integrals.int_tri, self.cv, s.mom)
+        if out is None:
+            out = np.empty(self.n)
+        out[0:self.n1] = s.mom.ts.ravel()
+        out[self.n1:2 * self.n1] = s.mom.qxs.ravel()
+        out[2 * self.n1:self.nmom] = s.mom.qys.ravel()
+        if self.nw:
+            out[self.nmom:] = (bd.flux_wall[self.wfaces] - self._psi(s.mom.ts)).ravel()

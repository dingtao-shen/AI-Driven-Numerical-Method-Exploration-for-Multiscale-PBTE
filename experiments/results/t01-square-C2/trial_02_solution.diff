+            xp = ((fx2 - fx1) / ln)[:, None] * absc + fx1[:, None]
+            yp = ((fy2 - fy1) / ln)[:, None] * absc + fy1[:, None]
+            pm = _eval_mono(C, mono,
+                            bA[:, None] * xp + cA[:, None] * yp + dA[:, None],
+                            fE[:, None] * xp + gE[:, None] * yp + hE[:, None])
+
+            inner = mesh.face_bc[fcid] < 0
+            t1 = mesh.face_tri[fcid, 0]
+            t2 = mesh.face_tri[fcid, 1]
+            other = np.where(t1 == tri_ids, t2, t1)

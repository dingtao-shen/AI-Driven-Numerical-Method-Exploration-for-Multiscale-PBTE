+# ---------------------------------------------------------------------------
+# Krylov
+# ---------------------------------------------------------------------------
+def gmres(matvec, b, tol, maxiter, restart=120, precond=None, x0=None,
+          callback=None):
+    """Right-preconditioned restarted GMRES.
+
+    Right preconditioning keeps the Arnoldi residual equal to the *true*
+    residual of ``A x = b``, so the stopping test means what it says however
+    good or bad the preconditioner is -- and lets a preconditioner be built
+    halfway through a solve and applied to the iterate already reached.
+
+    ``maxiter`` counts matrix-vector products, including the one each restart
+    spends re-forming the residual, because here a product is a transport
+    sweep and the caller is budgeting sweeps.  ``restart`` bounds the Krylov
+    basis, and so the memory: without it a caller that passes ``tmax`` as the
+    iteration limit asks for a basis of ``tmax`` vectors.
+
+    Returns ``(x, residuals, converged)``; ``residuals[k]`` is
+    ``||b - A x_k|| / ||b||`` and includes the starting point.
+    """
+    n = b.size
+    bnorm = float(np.linalg.norm(b))
+    if bnorm == 0.0:
+        return np.zeros(n), [0.0], True
+    x = np.zeros(n) if x0 is None else np.array(x0, dtype=float)
+    seeded = x0 is not None
+    m = max(1, min(int(restart), int(maxiter)))
+    V = np.empty((m + 1, n))
+    Z = np.empty((m, n))
+    H = np.zeros((m + 1, m))
+    cs = np.zeros(m)
+    sn = np.zeros(m)
+    g = np.zeros(m + 1)
+
+    res: list[float] = []
+    used = 0
+    converged = False
+    while True:
+        if seeded:
+            r = b - matvec(x)
+            used += 1
+        else:
+            r = b.copy()
+            seeded = True
+        beta = float(np.linalg.norm(r))
+        if not res:
+            res.append(beta / bnorm)
+        if beta / bnorm <= tol:
+            converged = True
+            break
+        room = min(m, maxiter - used)
+        if room <= 0:
+            break
+
+        H[:] = 0.0
+        g[:] = 0.0
+        g[0] = beta
+        V[0] = r / beta
+        k = 0
+        while k < room:
+            Z[k] = precond(V[k]) if precond is not None else V[k]
+            w = matvec(Z[k])
+            used += 1
+            for i in range(k + 1):                  # modified Gram-Schmidt
+                H[i, k] = float(V[i] @ w)
+                w -= H[i, k] * V[i]
+            H[k + 1, k] = float(np.linalg.norm(w))
+            breakdown = H[k + 1, k] <= 0.0
+            if not breakdown:
+                V[k + 1] = w / H[k + 1, k]
+            for i in range(k):                      # apply past rotations
+                t = cs[i] * H[i, k] + sn[i] * H[i + 1, k]
+                H[i + 1, k] = -sn[i] * H[i, k] + cs[i] * H[i + 1, k]
+                H[i, k] = t
+            d = np.hypot(H[k, k], H[k + 1, k])
+            if d == 0.0:
+                cs[k], sn[k] = 1.0, 0.0
+            else:
+                cs[k], sn[k] = H[k, k] / d, H[k + 1, k] / d
+            H[k, k] = cs[k] * H[k, k] + sn[k] * H[k + 1, k]
+            H[k + 1, k] = 0.0
+            g[k + 1] = -sn[k] * g[k]
+            g[k] = cs[k] * g[k]
+            k += 1
+            res.append(abs(g[k]) / bnorm)
+            if callback is not None:
+                callback(len(res) - 1, res[-1])
+            if res[-1] <= tol:
+                converged = True
+                break
+            if breakdown:        # the Krylov space is exhausted: x_k is exact
+                converged = True
+                break
+
+        y = np.linalg.solve(np.triu(H[:k, :k]), g[:k])
+        for i in range(k):
+            x += y[i] * Z[i]
+        if converged or used >= maxiter:
+            break
+    return x, res, converged
+
+
+# ---------------------------------------------------------------------------
+def estimate_krylov_iterations(case, mesh) -> float:
+    """How many sweeps an unpreconditioned Krylov solve is likely to need.
+
+    In the diffusion limit source iteration contracts by
+    ``rho ~ 1 - (pi tau_C Vg / L)^2 / 3`` on the slowest spatial mode, so it
+    needs ``O((L / tau_C Vg)^2)`` sweeps and a Krylov method the square root of
+    that.  The prefactor is fitted to the shipped cavity and is only ever used
+    to decide whether building a preconditioner will pay for itself -- if the
+    guess is wrong the solve notices and switches anyway.
+    """
+    length = float(np.sqrt(mesh.tri_area.sum()))
+    mfp = case.tau_c * case.flow.vg
+    return 2.2 * length / max(mfp, 1e-300)
+
+
+def flux_feedback_strength(case, mesh) -> float:
+    """How strongly the heat flux feeds back into the scattering source.
+
+    Normal scattering conserves momentum, so it returns ``q`` to the source
+    with weight ``3 q.c / (4 pi tau_N Vg^2)``; against a diffusive
+    ``q ~ Cv Vg^2 tau_R grad(T) / 3`` that is ``tau_C tau_R / (tau_N L)``
+    relative to the temperature drive.  Below about ``1e-4`` the flux blocks of
+    the preconditioner are dead weight.
+    """
+    length = float(np.sqrt(mesh.tri_area.sum()))
+    return case.tau_c * case.flow.tau_r / (case.flow.tau_n * length)

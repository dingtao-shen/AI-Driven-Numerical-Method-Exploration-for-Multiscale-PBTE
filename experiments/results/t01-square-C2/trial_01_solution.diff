+@njit(cache=True, inline="always")
+def lu_solve_block(a, ipiv, b, bs):
+    """``DGETRS('N')`` for ``bs`` right-hand sides stored as ``b[row, rhs]``."""
+    n = a.shape[0]
+    for k in range(n):
+        p = ipiv[k]
+        if p != k:
+            for c in range(bs):
+                t = b[k, c]
+                b[k, c] = b[p, c]
+                b[p, c] = t
+    for k in range(n):
+        for i in range(k + 1, n):
+            f = a[i, k]
+            if f != 0.0:
+                for c in range(bs):
+                    b[i, c] -= f * b[k, c]
+    for k in range(n - 1, -1, -1):
+        r = 1.0 / a[k, k]
+        for c in range(bs):
+            b[k, c] *= r
+        for i in range(k):
+            f = a[i, k]
+            if f != 0.0:
+                for c in range(bs):
+                    b[i, c] -= f * b[k, c]
+
+
+@njit(cache=True)
+def _propagate_columns(order, d, cxd, cyd, lu, piv, mass, ttfc, nx, ny,
+                       tri_faces, face_bc, neighbour, periodic_tri, bc_type,
+                       wall_of_face, nm, c0, bs, x, src):
+    """One direction's sweep, carried out on ``bs`` sources at once.
+
+    Source column ``i*ndof + l`` is a unit ``INT_NODFUNC_TRI_TRI(l, :, i)`` in
+    element ``i``; columns past ``nm`` are unit diffuse-wall emissions.  Same
+    ordering, same upwind terms and same element solve as the real sweep --
+    only the right-hand side is a block instead of a vector.
+    """
+    n_tris = order.shape[1]
+    nd = mass.shape[0]
+    for k in range(n_tris):
+        i = order[d, k]
+        for m in range(nd):
+            for c in range(bs):
+                src[m, c] = 0.0
+        for il in range(3):
+            speed = cxd * nx[i, il] + cyd * ny[i, il]
+            w = 0.5 * (speed - abs(speed))
+            if w == 0.0:
+                continue
+            fc = tri_faces[i, il]
+            bc = face_bc[fc]
+            iext = -1
+            if bc < 0:
+                iext = neighbour[i, il]
+            elif bc_type[bc] == 3:
+                iext = periodic_tri[fc]
+            elif bc_type[bc] == 2:
+                base = nm + wall_of_face[fc] * nd - c0
+                for m0 in range(nd):
+                    c = base + m0
+                    if 0 <= c < bs:
+                        src[m0, c] += w
+            if iext >= 0:
+                for l in range(nd):
+                    for m in range(nd):
+                        t = -w * ttfc[i, il, m, l]
+                        if t != 0.0:
+                            for c in range(bs):
+                                src[m, c] += t * x[iext, l, c]
+        for l0 in range(nd):
+            c = i * nd + l0 - c0
+            if 0 <= c < bs:
+                for m in range(nd):
+                    src[m, c] += mass[l0, m, i]
+        lu_solve_block(lu[d, i], piv[d, i], src, bs)
+        for m in range(nd):
+            for c in range(bs):
+                x[i, m, c] = src[m, c]
+
+
+@njit(cache=True)
+def _accumulate_columns(cxd, cyd, wd, x, nd, nm, c0, bs, nmass,
+                        wall_tri, wall_lfc, nx, ny, fcm, inv_wall_norm,
+                        row_scale, col_scale, cvec, out):
+    """Fold one direction's response into ``I - G``.
+
+    The nine moment blocks are ``sum_d dOmega c_p c_q X_d`` scaled by the
+    moment-to-source factors, so they are accumulated straight into their
+    place in the final matrix; there is no intermediate to touch.
+    """
+    n_tris = x.shape[0]
+    nwf = wall_tri.shape[0]
+    nb = row_scale.shape[0]
+    wall0 = nb * nm
+    cvec[1] = cxd
+    cvec[2] = cyd
+    for p in range(nb):
+        rbase = p * nm
+        for q in range(nb):                              # moment x moment
+            cf = -row_scale[p] * col_scale[q] * wd * cvec[p] * cvec[q]
+            cbase = q * nm + c0
+            for i in range(n_tris):
+                for l in range(nd):
+                    row = rbase + i * nd + l
+                    for c in range(nmass):
+                        out[row, cbase + c] += cf * x[i, l, c]
+        if nmass < bs:                                   # moment x wall
+            cf = -row_scale[p] * wd * cvec[p]
+            cbase = wall0 + c0 - nm
+            for i in range(n_tris):
+                for l in range(nd):
+                    row = rbase + i * nd + l
+                    for c in range(nmass, bs):
+                        out[row, cbase + c] += cf * x[i, l, c]
+    for jf in range(nwf):
+        tri = wall_tri[jf]
+        lfc = wall_lfc[jf]
+        u = -cxd * nx[tri, lfc] - cyd * ny[tri, lfc]
+        if u >= 0.0:
+            continue
+        base = inv_wall_norm[jf] * u * wd
+        for m0 in range(nd):
+            row = wall0 + jf * nd + m0
+            for c in range(bs):
+                acc = 0.0
+                for l in range(nd):
+                    acc += fcm[tri, lfc, m0, l] * x[tri, l, c]
+                if c < nmass:
+                    for q in range(nb):
+                        out[row, q * nm + c0 + c] += \
+                            base * col_scale[q] * cvec[q] * acc
+                else:
+                    out[row, wall0 + c0 + c - nm] += base * acc
+
+
+@njit(cache=True, parallel=True)
+def response_matrix(order, cxv, cyv, domega, lu, piv, mass, ttfc, nx, ny,
+                    tri_faces, face_bc, neighbour, periodic_tri, bc_type,
+                    wall_of_face, wall_tri, wall_lfc, fcm, inv_wall_norm,
+                    n_tri_dof, blocksize, row_scale, col_scale, out):
+    """``I - G`` for the condensed map, from multi-right-hand-side sweeps.
+
+    The direction dependence of the scattering source factorises -- the source
+    is ``M (a + cx bx + cy by)`` -- so one propagation per column serves all
+    three input fields, and the nine ``sum_d dOmega c_p c_q X_d`` blocks are
+    accumulated straight into ``out``.  Writing into the final matrix rather
+    than into six intermediates is worth doing: the intermediates are 76 MB on
+    the shipped case and touching them costs more than the propagation.
+
+    ``row_scale``/``col_scale`` carry the moment-to-source conversion, one
+    entry per retained field (``Ts`` alone, or ``Ts, qx, qy``).  ``out`` is
+    ``(nb*n_tri_dof + n_wall_dof)`` square and is accumulated into, not
+    overwritten -- the caller seeds it with the identity.
+
+    Threads own disjoint column blocks, and a column block maps to disjoint
+    columns of ``out``, so the accumulation needs no reduction.
+    """
+    ndir = cxv.shape[0]
+    n_tris = order.shape[1]
+    nd = mass.shape[0]
+    nm = n_tri_dof
+    ncol = nm + wall_tri.shape[0] * nd
+    nblk = (ncol + blocksize - 1) // blocksize
+    for blk in prange(nblk):
+        c0 = blk * blocksize
+        bs = min(blocksize, ncol - c0)
+        nmass = min(max(nm - c0, 0), bs)         # mass columns in this block
+        x = np.zeros((n_tris, nd, bs))
+        src = np.empty((nd, bs))
+        cvec = np.ones(3)
+        for d in range(ndir):
+            _propagate_columns(order, d, cxv[d], cyv[d], lu, piv, mass, ttfc,
+                               nx, ny, tri_faces, face_bc, neighbour,
+                               periodic_tri, bc_type, wall_of_face,
+                               nm, c0, bs, x, src)
+            _accumulate_columns(cxv[d], cyv[d], domega[d], x, nd, nm, c0, bs,
+                                nmass, wall_tri, wall_lfc, nx, ny, fcm,
+                                inv_wall_norm, row_scale, col_scale, cvec, out)
diff -ruN -x __pycache__ -x '*.pyc' -x .pytest_cache -x out environment/pybte/accel.py solution/pybte/accel.py
--- environment/pybte/accel.py	1970-01-01 08:00:00.000000000 +0800
+++ solution/pybte/accel.py	2026-09-10 04:32:46.693674963 +0800
@@ -0,0 +1,378 @@
+"""Solving the outer iteration instead of iterating it.
+
+The sweep is an *exact* transport solve: within a direction the elements are
+visited in a topological order of the upwind graph, so every inflow term is
+read after the neighbour that produces it has been written, and what comes out
+of ``DG_Solver_VDF`` is ``f = L^-1 (scattering source + wall inflow)`` with no
+dependence at all on the ``f`` that went in.  One outer iteration therefore
+only ever communicates through the handful of fields the source is built from:
+
+    Ts, qx, qy      per element DOF -- the moments of the previous iterate
+    FLUX_WALL       per diffusely reflecting face -- its emission
+
+Stack those into ``z`` and the whole outer loop is an *affine* map,
+``z -> G z + g``, with ``G`` linear and ``g`` the wall-temperature drive.
+Source iteration is then plain Richardson on ``(I - G) z = g``, and its
+spectral radius goes to 1 as the medium becomes optically thick -- which is
+exactly the pseudo-convergence the shipped solver runs into.  Nothing about
+the discrete system is stiff; only that particular way of solving it is.
+
+So we solve the system.  :class:`CondensedSystem` is ``(I - G)`` with one
+matrix-vector product per transport sweep, and :func:`gmres` drives it to a
+residual far below the level at which the answer is still moving.  For the
+optically thick cases GMRES alone still needs hundreds of sweeps, so
+:func:`condensed_matrix` builds ``I - G`` *explicitly* -- on a coarse angular
+quadrature, which is cheap and, because both quadratures share the same
+diffusion limit, captures precisely the modes that make the fine problem
+slow.  It enters only as a preconditioner, so its accuracy sets the iteration
+count and never the answer.
+"""
+from __future__ import annotations
+
+import numpy as np
+
+from . import _kernels
+from .constants import BC_NONTHERMALISING, PI
+from .moments import compute_moments
+from .ordering import build_sweep_order
+from .velocity import VelocityMesh
+
+__all__ = ["CondensedSystem", "condensed_matrix", "coarse_velocity_mesh",
+           "gmres", "estimate_krylov_iterations", "flux_feedback_strength"]
+
+
+# ---------------------------------------------------------------------------
+# the condensed map
+# ---------------------------------------------------------------------------
+class CondensedSystem:
+    """``(I - G)`` for the outer iteration's affine map, one sweep per product.
+
+    The state is ``z = (Ts, qx, qy, FLUX_WALL)`` flattened element-major, i.e.
+    element ``i`` DOF ``l`` at ``i*ndof + l``, which is the order the response
+    kernel writes its columns in.
+    """
+
+    def __init__(self, solver):
+        self.solver = solver
+        s = solver
+        self.ndof = s.ndof
+        self.n_tris = s.n_tris
+        self.nmom = s.ndof * s.n_tris
+
+        m = s.mesh
+        if s.bcdata.has_nonthermalising:
+            bc_type = s.bcdata.bc_type
+            faces = [f for f in range(m.n_faces)
+                     if m.face_bc[f] >= 0
+                     and bc_type[m.face_bc[f]] == BC_NONTHERMALISING]
+        else:
+            faces = []
+        self.wall_faces = np.array(faces, dtype=np.int32)
+        self.nwall = self.wall_faces.size * self.ndof
+        self.n = 3 * self.nmom + self.nwall
+        self.bc_temp = s.ctx.bc_temp.copy()
+        self.sweeps = 0
+
+    # -- packing ----------------------------------------------------------
+    def load(self, z) -> None:
+        """Write ``z`` into the solver's moments and wall emission."""
+        s = self.solver
+        k, nd, nt = self.nmom, self.ndof, self.n_tris
+        s.mom.ts[:] = z[:k].reshape(nt, nd).T
+        s.mom.qxs[:] = z[k:2 * k].reshape(nt, nd).T
+        s.mom.qys[:] = z[2 * k:3 * k].reshape(nt, nd).T
+        if self.nwall:
+            s.bcdata.flux_wall[:] = 0.0
+            s.bcdata.flux_wall[self.wall_faces] = z[3 * k:].reshape(-1, nd)
+
+    def store(self) -> np.ndarray:
+        s = self.solver
+        parts = [s.mom.ts.T.ravel(), s.mom.qxs.T.ravel(), s.mom.qys.T.ravel()]
+        if self.nwall:
+            parts.append(s.bcdata.flux_wall[self.wall_faces].ravel())
+        return np.concatenate(parts)
+
+    # -- the map ----------------------------------------------------------
+    def apply(self, z, homogeneous: bool = False) -> np.ndarray:
+        """One outer iteration started from ``z``: ``G z + g``.
+
+        ``homogeneous`` zeroes the wall temperatures for the duration, which
+        drops ``g`` and leaves the linear part alone.
+        """
+        s = self.solver
+        self.load(z)
+        if homogeneous:
+            s.ctx.bc_temp[:] = 0.0
+        try:
+            s.ctx.sweep(s.mom, s.vdf)
+            self.sweeps += 1
+            if s.ctx.mode == "onthefly":
+                s.factorisation_count += s.ndir * s.n_tris
+            compute_moments(s.vdf, s.ctx.cxv, s.ctx.cyv, s.ctx.domega,
+                            s.integrals.int_tri, s.case.flow.cv, s.mom)
+            if self.nwall:
+                s.bcdata.update_wall_flux(s.vdf, s.ctx.cxv, s.ctx.cyv,
+                                          s.ctx.domega,
+                                          s.integrals.int_tri_fc, s.mesh)
+        finally:
+            s.ctx.bc_temp[:] = self.bc_temp
+        return self.store()
+
+    def rhs(self) -> np.ndarray:
+        """``g = Phi(0)`` -- what the walls alone drive into the domain."""
+        return self.apply(np.zeros(self.n))
+
+    def matvec(self, z) -> np.ndarray:
+        return z - self.apply(z, homogeneous=True)
+
+
+# ---------------------------------------------------------------------------
+# reduced angular quadrature
+# ---------------------------------------------------------------------------
+def coarse_velocity_mesh(npole: int, nazim: int, vg: float = 1.0) -> VelocityMesh:
+    """A small ordinate set with the *exact* moments the diffusion limit needs.
+
+    Gauss-Legendre in ``mu = cos(theta)`` and the midpoint rule in ``phi``, so
+    that ``sum dOmega``, ``sum dOmega c_i`` and ``sum dOmega c_i c_j`` are
+    exact for any ``npole >= 2``, ``nazim >= 4``.  Getting the second moment
+    right is what makes the coarse operator share a diffusion limit with the
+    fine one, and that is the whole reason it preconditions well.
+
+    The fields are laid out like :class:`~pybte.velocity.VelocityMesh` so that
+    the ordering pass and the operator builder can be reused unchanged.
+    """
+    mu, wmu = np.polynomial.legendre.leggauss(npole)
+    sin_the = np.sqrt(1.0 - mu * mu)
+    the = np.arccos(mu)
+    wthe = wmu / sin_the                       # so that sin(the)*wthe == wmu
+    phi = (np.arange(nazim) + 0.5) * (2.0 * PI / nazim)
+    wphi = np.full(nazim, 2.0 * PI / nazim)
+    domega = (sin_the * wthe)[:, None] * wphi[None, :]
+    cx = np.repeat((vg * mu)[:, None], nazim, axis=1)
+    cy = (vg * sin_the)[:, None] * np.cos(phi)[None, :]
+    return VelocityMesh(the=the, wthe=wthe, phi=phi, wphi=wphi,
+                        domega=domega, cx=cx, cy=cy)

+# ---------------------------------------------------------------------------
+# the explicit response operator
+# ---------------------------------------------------------------------------
+def condensed_matrix(solver, npole: int, nazim: int, with_flux: bool,
+                     blocksize: int = 32, dtype=np.float32):
+    """``I - G`` written out as a dense matrix on a reduced angular set.
+
+    Building it costs one propagation per unknown *per coarse direction*, which
+    is why the angular set is coarse: the fine 200-ordinate problem would cost
+    twenty times as much for a preconditioner that is no better.  What the
+    coarse set has to get right is the second angular moment, because that is
+    what fixes the diffusion limit the two operators have to share; see
+    :func:`coarse_velocity_mesh`.
+
+    ``with_flux`` decides whether the heat flux is carried as an unknown.
+    Dropping it shrinks the matrix threefold in each direction, and it is only
+    worth carrying when normal scattering is strong enough to feed ``q`` back
+    into the source.
+
+    Returns ``(matrix, index, ndir)``; ``index`` picks the rows of the
+    condensed state the matrix corresponds to, and ``ndir`` is how many
+    ordinates it was built on.
+    """
+    s = solver
+    c = s.case
+    nd, nt = s.ndof, s.n_tris
+    nmom = nd * nt
+    wall_faces = np.array(
+        [f for f in range(s.mesh.n_faces)
+         if s.mesh.face_bc[f] >= 0
+         and s.bcdata.bc_type[s.mesh.face_bc[f]] == BC_NONTHERMALISING],
+        dtype=np.int32)
+    nwf = wall_faces.size
+    nwall = nwf * nd
+
+    wall_of_face = np.zeros(s.mesh.n_faces, dtype=np.int32)
+    wall_of_face[wall_faces] = np.arange(nwf, dtype=np.int32)
+    wall_tri = np.empty(nwf, dtype=np.int32)
+    wall_lfc = np.empty(nwf, dtype=np.int32)
+    for jf, f in enumerate(wall_faces):
+        side = 0 if s.mesh.face_tri[f, 0] >= 0 else 1
+        wall_tri[jf] = s.mesh.face_tri[f, side]
+        wall_lfc[jf] = s.mesh.face_lfc[f, side]
+
+    vel = coarse_velocity_mesh(npole, nazim, c.flow.vg)
+    order = np.ascontiguousarray(build_sweep_order(s.mesh, vel).order,
+                                 dtype=np.int32)
+    cxv, cyv, domega = (np.ascontiguousarray(a) for a in vel.flat())
+    ndir = cxv.size
+
+    lu = np.empty((ndir, nt, nd, nd))
+    piv = np.empty((ndir, nt, nd), dtype=np.int32)
+    bad = _kernels.build_operators(order, cxv, cyv, 1.0 / c.tau_c,
+                                   s.ctx.mass, s.ctx.gx, s.ctx.gy,
+                                   s.ctx.fcm, s.ctx.nx, s.ctx.ny, lu, piv)
+    if bad:
+        raise np.linalg.LinAlgError(f"{bad} coarse element operators are singular")
+
+    # the denominator of Calculate_FLUX_WALL, on this quadrature
+    inv_wall_norm = np.empty(nwf)
+    for jf in range(nwf):
+        u = -cxv * s.ctx.nx[wall_tri[jf], wall_lfc[jf]] \
+            - cyv * s.ctx.ny[wall_tri[jf], wall_lfc[jf]]
+        inc = u > 0.0
+        inv_wall_norm[jf] = 1.0 / float(np.sum(-u[inc] * domega[inc]))
+
+    # moments -> scattering source: Ts enters with 1/tau_R + 1/tau_N, the flux
+    # with 1/tau_N alone; the outgoing moments carry the 1/Cv of Ts
+    cv, vg = c.flow.cv, c.flow.vg
+    a_ts = cv / (4.0 * PI) * (1.0 / c.flow.tau_r + 1.0 / c.flow.tau_n)
+    a_q = 3.0 / (4.0 * PI * c.flow.tau_n * vg * vg)
+    if with_flux:
+        row_scale = np.array([1.0 / cv, 1.0, 1.0])
+        col_scale = np.array([a_ts, a_q, a_q])
+        index = np.arange(3 * nmom + nwall)
+    else:
+        row_scale = np.array([1.0 / cv])
+        col_scale = np.array([a_ts])
+        index = np.concatenate([np.arange(nmom),
+                                np.arange(3 * nmom, 3 * nmom + nwall)])
+    n = row_scale.size * nmom + nwall
+    out = np.zeros((n, n), dtype=dtype)
+    out[np.diag_indices(n)] = 1.0
+    _kernels.response_matrix(
+        order, cxv, cyv, domega, lu, piv, s.ctx.mass, s.ctx.ttfc,
+        s.ctx.nx, s.ctx.ny, s.ctx.tri_faces, s.ctx.face_bc, s.ctx.neighbour,
+        s.ctx.periodic_tri, s.ctx.bc_type, wall_of_face, wall_tri, wall_lfc,
+        np.ascontiguousarray(s.integrals.int_tri_fc), inv_wall_norm,
+        nmom, blocksize, row_scale, col_scale, out)
+    return out, index, ndir
+
